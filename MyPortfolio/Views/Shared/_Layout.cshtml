<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    
    <!-- Meta descriptions optimisées (bilingues pour capter les deux audiences) -->
    <meta name="description" content="Tech entrepreneur & developer portfolio in Guinea. Discover innovative digital projects, IT training, social initiatives (school construction), and tech news from Conakry to the world.">
    <meta name="keywords" content="Guinea tech, software engineer, developer Guinea, IT training Conakry, digital innovation West Africa, portfolio tech Guinea, mentor, cours en ligne, projets digitaux Guinée, formation développement Guinée, IT, meetup,Building a school in Guinea project, IT training, formation informatique, web development training">
    
    <!-- Balise d'audience bilingue (informative pour Google) -->
    <meta name="language" content="en, fr">
    <meta name="target-audience" content="international, Guinea">
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Title optimisé SEO avec mots-clés stratégiques -->
    <title>@ViewData["Title"]</title>
    
    <!-- Vérification Google Search Console -->
    <meta name="google-site-verification" content="AD3xA3r_fbx_9nyon3ph0QIdMXle_xBzxGHHKzpoHRw" />

    <!-- Favicons -->
    <link href="~/lib/images/favicon.png" rel="icon">
    <link href="~/lib/images/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Open Graph / Facebook (pour les partages sociaux) -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Abdoulaye Bah - Tech Portfolio Guinea">
    <meta property="og:title" content="@ViewData["Title"] - Tech Innovation in Guinea">
    <meta property="og:description" content="Discover tech projects, IT training, and social initiatives from a Guinea-based developer. From school construction to digital economy solutions.">
    <meta property="og:image" content="https://votresite.com/lib/images/og-image.jpg">
    <meta property="og:url" content="https://votresite.com">
    <meta property="og:locale" content="en_US">
    <meta property="og:locale:alternate" content="fr_GN">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@ViewData["Title"] - Tech Portfolio Guinea">
    <meta name="twitter:description" content="Tech entrepreneur in Guinea: digital projects, IT training, and social impact initiatives.">
    <meta name="twitter:image" content="https://votresite.com/lib/images/twitter-card.jpg">

    <!-- Géolocalisation indicative pour la Guinée -->
    <meta name="geo.region" content="GN">
    <meta name="geo.placename" content="Conakry, Guinea">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/lib/bootstrap/main/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/lib/aos/aos.css" rel="stylesheet">
    <link href="~/lib/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/lib/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="canonical" href="https://mdoumbouya-universe.com/">
</head>
<body>
    <header id="header" class="header dark-background d-flex flex-column">
        <i class="header-toggle d-xl-none bi bi-list"></i>

        <div class="profile-img">
            <img src="@Url.Content("~/images/profile-img.jpeg")" alt="" class="img-fluid rounded-circle">
        </div>

        <a href="#hero" class="logo d-flex align-items-center justify-content-center">
            <!-- Uncomment the line below if you also wish to use an image logo -->
            <!-- <img src="@Url.Content("~/images/my-profile-img.jpg")" alt=""> -->
            <h1 class="sitename">Mohamed DOUMBOUYA</h1>
        </a>

        <div class="social-links text-center">
            <!--<a href="#" class="twitter"><i class="bi bi-twitter-x"></i></a>-->
            <!--<a href="#" class="facebook"><i class="bi bi-facebook"></i></a>-->
            <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
            <!--<a href="#" class="google-plus"><i class="bi bi-skype"></i></a>-->
            <a href="https://www.linkedin.com/in/doumbouya-mohamed/" class="linkedin"><i class="bi bi-linkedin"></i></a>
        </div>

        <nav id="navmenu" class="navmenu">
            <ul>
                <li>
                    <a asp-controller="Home" asp-action="Index"
                       asp-active-by-controller="Home" asp-active-by-action="Index">
                        <i class="bi bi-house navicon"></i>Home
                    </a>
                </li>
                <li>
                    <a asp-controller="Account" asp-action="Details"
                       asp-active-by-controller="Account" asp-active-by-action="Details">
                        <i class="bi bi-person navicon"></i> About
                    </a>
                </li>
                <li>
                    <a asp-controller="Resume" asp-action="Details"
                       asp-active-by-controller="Resume" asp-active-by-action="Details">
                        <i class="bi bi-file-earmark-text navicon"></i> Resume
                    </a>
                </li>
                <li>
                    <a asp-controller="Projects" asp-action="Index"
                       asp-active-by-controller="Projects" asp-active-by-action="Index">
                        <i class="bi bi-images navicon"></i> Projects
                    </a>
                </li>
                <li>
                    <a asp-controller="Services" asp-action="Index"
                       asp-active-by-controller="Services" asp-active-by-action="Index">
                        <i class="bi bi-hdd-stack navicon"></i> Services
                    </a>
                </li>
                <li>
                    <a asp-controller="Contact" asp-action="Index"
                       asp-active-by-controller="Contact" asp-active-by-action="Index">
                        <i class="bi bi-envelope navicon"></i> Contact
                    </a>
                </li>
            </ul>
        </nav>

    </header>

    <main role="main" class="main">
        @RenderBody()
    </main>

    <footer id="footer" class="footer position-relative light-background">
        <div class="container">
            <div class="copyright text-center">
                <p>© <span>Copyright</span> <strong class="px-1 sitename">Doumbouya Mohamed</strong> <span>All Rights Reserved</span></p>
            </div>
            <div class="credits">
                <!-- All the links in the footer should remain intact to respect the free license -->
                Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a>
            </div>
        </div>
    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
@*     <div id="preloader"></div>
 *@
    <!-- Vendor JS Files -->
    <script src="~/lib/bootstrap/main/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/php-email-form/validate.js"></script>
    <script src="~/lib/aos/aos.js"></script>
    <script src="~/lib/typed.js/typed.umd.js"></script>
    <script src="~/lib/purecounter/purecounter_vanilla.js"></script>
    <script src="~/lib/waypoints/noframework.waypoints.js"></script>
    <script src="~/lib/glightbox/js/glightbox.min.js"></script>
    <script src="~/lib/imagesloaded/imagesloaded.pkgd.min.js"></script>
    <script src="~/lib/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="~/lib/swiper/swiper-bundle.min.js"></script>

    <!-- Main JS File -->
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
